{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "2.1",
  "description": "__MSG_appDesc__",
  
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "Icon16.png",
      "32": "Icon32.png",
      "64": "Icon64.png",
      "128": "Icon128.png",
      "256": "Icon256.png",
      "512": "Icon512.png"
    }
  },
  
  "icons": {
    "16": "Icon16.png",
    "32": "Icon32.png",
    "64": "Icon64.png",
    "128": "Icon128.png",
    "256": "Icon256.png",
    "512": "Icon512.png"
  },

  "commands": {
    "convert-uppercase": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "__MSG_cmdUppercase__"
    },
    "convert-lowercase": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_cmdLowercase__"
    },
    "convert-titlecase": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "__MSG_cmdTitleCase__"
    },
    "convert-camelcase": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "__MSG_cmdCamelCase__"
    }
  }
}